FLIMbuilder.pro:
myicons.qrc:
qmake: FORCE
	@$(QMAKE) -o Makefile FLIMbuilder.pro

qmake_all: FORCE


all: Makefile FLIMbuilder

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents myicons.qrc $(DISTDIR)/
	$(COPY_FILE) --parents /home/isabela/anaconda3/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents mainwindow.h common.h mygraphicsview.h markers.h mycombobox.h orientation.h runguard.h myplaintextedit.h graphnode.h graphedge.h projectiongraphicsview.h projection.h flim.h gflim.h gflimconfig.h $(DISTDIR)/
	$(COPY_FILE) --parents main.cpp mainwindow.cpp common.cpp mygraphicsview.cpp markers.cpp mycombobox.cpp orientation.cpp runguard.cpp myplaintextedit.cpp graphnode.cpp graphedge.cpp projectiongraphicsview.cpp projection.cpp flim.cpp gflim.cpp gflimconfig.cpp $(DISTDIR)/
	$(COPY_FILE) --parents mainwindow.ui projection.ui gflimconfig.ui $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) $(TARGET) 
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile


